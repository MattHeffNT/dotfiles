# ~/.zprofile — environment only (exported variables and PATH).
# Read by login shells; ~/.zshrc also loads it for non-login shells
# (e.g. new terminal windows), so this is the one place to set env.

# Keep PATH free of duplicates
typeset -U path PATH

# Homebrew (Linuxbrew)
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
  eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [[ -x $HOME/.linuxbrew/bin/brew ]]; then
  eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi

export EDITOR=nvim

# pnpm
export PNPM_HOME="$HOME/.local/share/pnpm"

# Android SDK (Capacitor / native-run / Gradle)
export ANDROID_HOME="$HOME/Android/Sdk"

path=(
  $HOME/.npm-global/bin    # npm -g installs (prefix set in ~/.npmrc)
  $HOME/.local/bin
  $PNPM_HOME
  $ANDROID_HOME/emulator
  $ANDROID_HOME/platform-tools
  $path
)
